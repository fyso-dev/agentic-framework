+#!/usr/bin/env bash
+# A certificate renewal must validate before replacing the active TLS config.
+set -euo pipefail
+source "$(dirname "$0")/lib.sh"
+node hub/scripts/render.cjs --check
+caddy validate --config "$RUNTIME/Caddyfile" --adapter caddyfile
+exec caddy reload --address "localhost:$HUB_CADDY_ADMIN_PORT" --config "$RUNTIME/Caddyfile" --adapter caddyfile
