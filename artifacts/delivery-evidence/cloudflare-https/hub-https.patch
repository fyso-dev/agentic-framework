+// Optional native TLS listener: private TCP forwarding reaches this port, while
+// every application retains its existing loopback gateway and authentication.
+function tlsListener(list) {
+  if (scheme !== 'https') return '';
+  const cert = env.HUB_TLS_CERT_FILE, key = env.HUB_TLS_KEY_FILE;
+  const port = Number(env.HUB_TLS_PORT || 8490);
+  if (!cert || !key || !fs.existsSync(cert) || !fs.existsSync(key)) throw Error('HTTPS requires existing HUB_TLS_CERT_FILE and HUB_TLS_KEY_FILE');
+  if (!Number.isInteger(port) || port < 1024 || port > 65535) throw Error('Invalid HUB_TLS_PORT');
+  const routes = [{hosts:['portal','auth','console'].map(app=>`${app}.${env.HUB_DOMAIN}`),port:Number(env.HUB_HTTP_PORT)},
+    ...list.map(item=>({hosts:item.apps.map(app=>`${app}.${item.domain}`),port:item.port}))];
+  // Validate before stopping a working hub or activating a renewal.
+  const certificate = new X509Certificate(fs.readFileSync(cert));
+  if (fs.statSync(key).mode & 0o077) throw Error('TLS key permissions must be private');
+  if (!certificate.checkPrivateKey(createPrivateKey(fs.readFileSync(key)))) throw Error('TLS certificate and key do not match');
+  if (Date.parse(certificate.validFrom) > Date.now() || Date.parse(certificate.validTo) <= Date.now()) throw Error('TLS certificate is not currently valid');
+  for (const host of routes.flatMap(r=>r.hosts)) {
+    if (!certificate.checkHost(host)) throw Error(`TLS certificate does not cover ${host}`);
+  }
+  const addresses = routes.flatMap(r=>r.hosts).map(host=>`https://${host}:${port}`);
+  let out = `\n${addresses.join(', ')} {\n\ttls ${JSON.stringify(cert)} ${JSON.stringify(key)}\n`;
+  routes.forEach((r,i)=>{
+    out += `\t@route${i} host ${r.hosts.join(' ')}\n\thandle @route${i} {\n\t\treverse_proxy 127.0.0.1:${r.port} {\n\t\t\theader_up Host {host}\n\t\t}\n\t}\n`;
+  });
+  return out + '\trespond 404\n}\n';
+}
