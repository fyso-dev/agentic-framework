# Example slot: customize before publishing.
version: "0.5"
processes:
  ext-[[ extension_id ]]:
    command: framework/scripts/run-ext.sh [[ extension_id ]] -- miniserve --interfaces 127.0.0.1 --port "$FYSO_EXT_[[ extension_id | upper | replace('-', '_') ]]_PORT" extensions/[[ extension_id ]]/public
    readiness_probe:
      exec: { command: extensions/[[ extension_id ]]/doctor.sh }
