# Gateway (PLAN §3, D10, D11, D19). Values come from the environment set by
# framework/scripts/run-caddy.sh. One subdomain per app.
{
	admin localhost:{$FYSO_CADDY_ADMIN_PORT}
	auto_https off
	# Local by default; a server sets FYSO_BIND (e.g. 0.0.0.0) and a real domain.
	default_bind {$FYSO_BIND:127.0.0.1}
	storage file_system {$FYSO_DATA}/caddy
}

(fyso_login) {
	basic_auth {
		{$FYSO_ADMIN_USER} {$FYSO_ADMIN_HASH}
	}
}

# Panel files and same-origin Dagu API.
http://panel.localhost:{$FYSO_HTTP_PORT} {
	import fyso_login
	@config path /config/project.json /config/apps.json /config/extensions.json /config/observability.json /config/bot-versioning.json
	handle @config {
		@read method GET HEAD
		handle @read {
			uri strip_prefix /config
			root * {$FYSO_DATA}/panel
			file_server
		}
		respond 405
	}
	handle /config/team.yaml {
		@read method GET HEAD
		handle @read {
			rewrite * /team.yaml
			root * {$FYSO_ROOT}/project/bots
			file_server
		}
		respond 405
	}
	handle /config/* {
		respond 404
	}
	# Only connector-management APIs are exposed. The OMB bearer stays in Caddy.
	@panelForeignOrigin {
		path /api/omb/*
		header Origin *
		not header Origin http://panel.{$FYSO_WEB_DOMAIN:localhost}:{$FYSO_HTTP_PORT}
	}
	@panelCrossSite {
		path /api/omb/*
		header Sec-Fetch-Site cross-site
	}
	@nativeConnectors path_regexp nativeConnectors ^/api/omb/(connectors(/(catalog|connected|tools|[a-z][a-z0-9_-]{0,63}(/authorize|/accounts/[A-Za-z0-9][A-Za-z0-9_-]{0,127})?))?|mcp/servers(/[a-z][a-z0-9_-]{0,31}(/test|/sign-in(/[0-9a-f-]{36})?|/sign-out)?)?)$
	handle @nativeConnectors {
		route {
			respond @panelForeignOrigin 403
			respond @panelCrossSite 403
			@badConnectorMethod not method GET POST PATCH DELETE
			respond @badConnectorMethod 405
			uri replace /api/omb/ /api/ 1
			header Cache-Control no-store
			reverse_proxy 127.0.0.1:{$FYSO_OMB_PORT} {
				header_up Authorization "Bearer {$FYSO_OMB_TOKEN}"
			}
		}
	}
	# Dedicated SOPS/native-activation glue; never send project keys through Dagu.
	handle /api/composio/setup {
		reverse_proxy 127.0.0.1:{$FYSO_CONNECTOR_SETUP_PORT}
	}
	handle /api/composio/* {
		respond 404
	}
	# Exact read-only native roster, without conversation history. No generic OMB proxy.
	handle /api/omb/bots {
		@rosterRead method GET
		handle @rosterRead {
			rewrite * /api/bots?messages=0
			reverse_proxy 127.0.0.1:{$FYSO_OMB_PORT} {
				header_up Authorization "Bearer {$FYSO_OMB_TOKEN}"
			}
		}
		respond 405
	}
	handle /api/omb/* {
		respond 404
	}
	handle_path /api/dagu/* {
		rewrite * /api/v1{uri}
		reverse_proxy 127.0.0.1:{$FYSO_DAGU_PORT}
	}
	handle {
		root * {$FYSO_PANEL_ROOT}
		try_files {path} /index.html
		# Asset names carry no hash (stable diffs in git), so always revalidate (ETag).
		header Cache-Control no-cache
		file_server
	}
}

# Dagu: same credentials as the gateway (D19). The browser asks once and
# Caddy forwards the same Authorization header; Dagu listens on 127.0.0.1 only.
http://dagu.localhost:{$FYSO_HTTP_PORT} {
	import fyso_login
	reverse_proxy 127.0.0.1:{$FYSO_DAGU_PORT}
}

# OMB's native session stays in the gateway. Browsers authenticate with the
# project's basic login; never forward their Authorization header to OMB.
http://omb.localhost:{$FYSO_HTTP_PORT} {
	import fyso_login
	# The injected bearer authenticates API calls, so enforce browser CSRF
	# protection at the gateway as well as OMB's own permission checks.
	@foreignOrigin {
		path /api/*
		header Origin *
		not header Origin http://omb.localhost:{$FYSO_HTTP_PORT}
	}
	respond @foreignOrigin 403
	@crossSite {
		path /api/*
		header Sec-Fetch-Site cross-site
	}
	respond @crossSite 403
	reverse_proxy 127.0.0.1:{$FYSO_OMB_PORT} {
		header_up Authorization "Bearer {$FYSO_OMB_TOKEN}"
		flush_interval -1
	}
}

# Project apps and extensions add their own routes here.
import {$FYSO_ROOT}/project/apps/*/Caddyfile
import {$FYSO_ROOT}/extensions/*/Caddyfile
