# Pinned tools, environment and tasks for this project (PLAN D1, D21).
# Change versions deliberately; never use "latest".
min_version = "2026.10.6"

[tools]
"aqua:dagucloud/dagu" = "2.24.0"
"npm:openmausbot" = "0.1.141"
"aqua:F1bonacc1/process-compose" = "1.124.0"
"aqua:caddyserver/caddy" = "2.11.9"
"aqua:getsops/sops" = "3.13.3"
"aqua:FiloSottile/age" = "1.3.2"
"aqua:gitleaks/gitleaks" = "8.30.1"
"core:node" = "24.15.0"
"npm:yaml" = "2.8.1"
"aqua:cli/cli" = "2.95.0"
"core:go" = "1.26.8"
"core:pnpm" = "11.1.2"

[settings.npm]
package_manager = "npm"

[env]
# Encrypted secrets (sops + age, PLAN D20). Created by `mise run setup`.
_.file = { path = "secrets.enc.yaml", redact = true }

FYSO_PROJECT = "{{ project_slug }}"
FYSO_PROJECT_NAME = "{{ project_name }}"
FYSO_ROOT = "{% raw %}{{ config_root }}{% endraw %}"
FYSO_DATA = "{% raw %}{{ config_root }}{% endraw %}/.data"
FYSO_ADMIN_USER = "{{ admin_user }}"
FYSO_WEB_DOMAIN = "{{ web_domain or (project_slug ~ '-' ~ port_base ~ '.localhost') }}"
# Empty: this project runs its own web login. Otherwise the shared login it trusts (D61).
FYSO_AUTH_UPSTREAM = "{{ auth_upstream }}"
FYSO_TINYAUTH_VERSION = "5.2.0"
FYSO_TINYAUTH_SHA256 = "5fec14cb1a7cf43ef5c9dafc9fa9fba6fcbc2d8fd328cd5a78dd42aae4c0efde" # gitleaks:allow public source checksum

# Port block (PLAN §3.1): base {{ port_base }}.
FYSO_HTTP_PORT = "{{ port_base }}"
FYSO_DAGU_PORT = "{{ port_base + 1 }}"
FYSO_DAGU_SCHEDULER_PORT = "{{ port_base + 2 }}"
FYSO_DAGU_WORKER_HEALTH_PORT = "{{ port_base + 3 }}"
FYSO_OMB_PORT = "{{ port_base + 4 }}"
FYSO_OMB_WEBHOOK_PORT = "{{ port_base + 5 }}"
FYSO_DAGU_COORDINATOR_PORT = "{{ port_base + 6 }}"
FYSO_DAGU_COORDINATOR_HEALTH_PORT = "{{ port_base + 7 }}"
FYSO_CADDY_ADMIN_PORT = "{{ port_base + 8 }}"
FYSO_AUTH_PORT = "{{ port_base + 9 }}"

# Every `openmausbot` CLI call targets THIS project's server, never the
# desktop app it would otherwise auto-discover on 8799.
# Coding agents opened in this project reach the Dagu MCP of .mcp.json with this header
# (D33); OpenMausBot sets the same value for bots. Derived, never stored.
DAGU_MCP_AUTH = "{% raw %}Basic {{ exec(command='printf %s:%s \"$FYSO_ADMIN_USER\" \"$FYSO_ADMIN_PASSWORD\" | base64 | tr -d \"\\n\"') }}{% endraw %}"

OPENMAUSBOT_URL = "http://127.0.0.1:{{ port_base + 4 }}"
ALLOW_INSECURE_HTTP = "true"

[tasks.setup]
description = "Create the age key (if missing), .sops.yaml and secrets.enc.yaml"
run = "framework/scripts/setup.sh"

[tasks.up]
description = "Start web login, Dagu, OpenMausBot and Caddy in the background"
run = "framework/scripts/up.sh"

[tasks.down]
description = "Stop every process of this project"
run = "framework/scripts/pc.sh down"

[tasks.status]
description = "Show the state of each process"
run = "framework/scripts/pc.sh process list"

[tasks.logs]
description = "Follow the logs of one process: mise run logs <dagu|omb|caddy>"
run = "framework/scripts/pc.sh process logs --follow"

[tasks."bots:plan"]
description = "Show how project/bots/team.yaml would change the bots"
run = "framework/scripts/bots.sh plan"

[tasks."bots:apply"]
description = "Apply project/bots/team.yaml to OpenMausBot"
run = "framework/scripts/bots.sh apply"

[tasks."bots:check"]
description = "Fail if the running bots differ from project/bots/team.yaml"
run = "framework/scripts/bots.sh check"

[tasks.auth]
description = "Check and set up the engine logins (Claude, Codex, API keys)"
run = "framework/scripts/auth.sh"

[tasks."web-auth:install"]
description = "Build the pinned, unmodified native login service"
run = "framework/scripts/install-web-auth.sh"

[tasks."web-auth:users"]
description = "Manage local web users while the stack is stopped: init, add <username>, remove <username>"
run = "framework/scripts/web-auth-users.sh"

[tasks.snapshot]
description = "Save bots, memory and workflows to git now (also runs hourly in Dagu)"
run = "framework/scripts/snapshot.sh bots && framework/scripts/snapshot.sh memory && framework/scripts/snapshot.sh commit"

[tasks.doctor]
description = "Check ports, logins, instances and routes"
run = "framework/scripts/doctor.sh"

[tasks."tray:install"]
description = "Show running Fyso projects in the macOS menu bar (needs SwiftBar)"
run = "framework/scripts/tray-install.sh"

[tasks.secrets]
description = "Edit the encrypted secrets file"
run = "sops edit secrets.enc.yaml"

[tasks."bots:architect"]
description = "Run Bot Architect's versioned Dagu workflow with JSON parameters"
run = "node framework/scripts/bot-architect.cjs submit"

[tasks."agent:setup"]
description = "Install Dagu's authoring skill (pinned to this Dagu) for Claude Code and Codex"
run = "framework/scripts/agent-setup.sh"

[tasks."agent:connect"]
description = "Add this project's fyso MCP to Claude Desktop / Codex (default: desktop apps found); also claude-code"
run = "node framework/scripts/agent-connect.cjs connect"

[tasks."agent:open"]
description = "Open Codex or Claude Desktop with a new conversation about this project (after agent:connect)"
run = "node framework/scripts/agent-connect.cjs open"

[tasks."agent:disconnect"]
description = "Remove this project's fyso MCP from Claude Desktop / Codex / Claude Code"
run = "node framework/scripts/agent-connect.cjs disconnect"

[tasks."ext:add"]
description = "Add an extension by catalog id or Copier source: mise run ext:add <id|src>"
run = "framework/scripts/ext.sh add"

[tasks."ext:update"]
description = "Update project extensions"
run = "framework/scripts/ext.sh update"

[tasks."ext:list"]
description = "List project extensions"
run = "framework/scripts/ext.sh list"

[tasks."dist:publish"]
description = "Publish this project's configuration, documents and memory as a new distribution version: mise run dist:publish [version]"
run = "framework/scripts/dist.sh publish"

[tasks."dist:add"]
description = "Install a distribution in this project (its files win): mise run dist:add <repo> [version]"
run = "framework/scripts/dist.sh add"

[tasks."dist:update"]
description = "Update to the latest distribution version (or the one given), merging bot memory"
run = "framework/scripts/dist.sh update"

[tasks."dist:status"]
description = "Show the installed distribution and whether a newer version exists"
run = "framework/scripts/dist.sh status"

[tasks."dist:key"]
description = "Print this installation's public key, for a publisher who sends secrets"
run = "framework/scripts/dist.sh key"

[tasks."ext:search"]
description = "Search the extension catalogs: mise run ext:search [text]"
run = "framework/scripts/ext.sh search"

[tasks."ext:remove"]
description = "Remove project extensions"
run = "framework/scripts/ext.sh remove"
