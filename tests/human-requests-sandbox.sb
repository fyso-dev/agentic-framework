(version 1)
;; Canary profile: reads are not isolated; never pass sensitive inputs or FDs.
(allow default)
(deny file-write*)
(allow file-write* (subpath (param "FIXTURE")))
(allow file-write* (literal "/dev/null"))
(deny mach-lookup)
(deny process-exec)
(allow process-exec (literal (param "PYTHON")))
(allow process-exec (literal (param "COPIER")))
(allow process-exec (literal (param "COPIER_PYTHON")))
(allow process-exec (literal (param "DAGU")))
(allow process-exec (literal (param "NODE")))
(allow process-exec (literal "/bin/realpath"))
(allow process-exec (literal "/usr/bin/dirname"))
(allow process-exec (literal "/bin/sh"))
(allow process-exec (literal "/bin/bash"))
(allow process-exec (literal "/bin/mkdir"))
(allow process-exec (literal "/usr/bin/env"))
(deny network-outbound)
(allow network-outbound (remote ip (param "PORT0")))
(allow network-outbound (remote ip (param "PORT1")))
(allow network-outbound (remote ip (param "PORT2")))
(allow network-outbound (remote ip (param "PORT3")))
(allow network-outbound (remote ip (param "PORT4")))
(deny network-inbound)
(allow network-inbound (local ip (param "PORT0")))
(allow network-inbound (local ip (param "PORT1")))
(allow network-inbound (local ip (param "PORT2")))
(allow network-inbound (local ip (param "PORT3")))
(allow network-inbound (local ip (param "PORT4")))

;; Dagu 2.24 hard-codes /tmp for its per-run socket. Permit exactly this
;; precomputed fictional run path; never grant a directory-wide exception.
(allow network-inbound (local unix-socket (literal (param "SOCKET"))))
(allow network-outbound (remote unix-socket (literal (param "SOCKET"))))
(allow file-write* (literal (param "SOCKET")))
